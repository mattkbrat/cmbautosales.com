---
import { ExternalLinkIcon, PhoneCallIcon } from "@lucide/astro";
---

<div class="flex flex-col bg-white/75 gap-y-0 border-t-2 px-2">
  <div class="container mx-auto">
    <h2 class="text-xl underline">Contact</h2>
    <p>Give us a call or drop on by.</p>
  </div>
  <section
    id="contact"
    class="py-2 sm:py-4 flex justify-between gap-x-4 align-start container mx-auto flex-wrap"
  >
    <section class="block">
      <h3 class="font-black underline uppercase text-md">Hours</h3>
      <div class="grid sm:grid-cols-[auto_1fr] gap-x-2">
        <span class="font-bold sm:text-right">Monday - Friday</span>
        <span class="pb-2">8:00 AM - 5:00 PM</span>
        <span class="font-bold sm:text-right">Saturday</span>
        <span class="pb-2">8:00 AM - 12:00 PM</span>
        <span class="font-bold sm:text-right">Sundays</span>
        <span class="">Closed</span>
      </div>
    </section>
    <section class="block">
      <h3 class="col-span-full font-black underline uppercase text-md">
        Address
      </h3>
      <p>
        16333 County Road V<br />
        Fort Morgan, CO 80701
      </p>
      <a
        href="https://www.google.com/maps/dir//CMB+Auto+Sales,+County+Road+V,+Fort+Morgan,+CO/@40.3691702,-103.8216578,12z/"
        target="_blank"
        rel="noreferrer"
      >
        <span class="font-bold">Get Directions</span>
      </a>
    </section>
    <section class="block">
      <h3 class="col-span-full font-black underline uppercase text-md">
        Contact
      </h3>
      <a href="tel:+9708676156">(970) 867-6156</a>
      <br />
      <a href="mailto:contact@cmbautosales.com" class="break-all">Email us</a>
    </section>
  </section>
  <hr class="w-full" />
  <footer
    class="h-max text-sm py-2 flex flex-row flex-wrap px-10 gap-y-2 w-full container justify-between mx-auto"
  >
    <p>© CMB AUTO SALES</p>
    <a
      href="https://mattkbrat.com"
      target="_blank"
      rel="noreferrer"
      class="flex flex-row gap-2 text-xs"
    >
      <span>A Solutions Artisan, LTD. product</span>
      <ExternalLinkIcon size={16} />
    </a>
  </footer>
</div>
